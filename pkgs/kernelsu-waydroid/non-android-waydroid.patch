diff --git a/kernel/hook/syscall_hook_manager.c b/kernel/hook/syscall_hook_manager.c
index 26ca600..531632f 100644
--- a/kernel/hook/syscall_hook_manager.c
+++ b/kernel/hook/syscall_hook_manager.c
@@ -5,6 +5,9 @@
 #include <asm/syscall.h>
 #include <linux/ptrace.h>
 #include <linux/slab.h>
+#include <linux/sched/task.h>
+#include <linux/sched/signal.h>
+#include <trace/events/sched.h>
 #include <trace/events/syscalls.h>
 
 #include <linux/version.h>
@@ -91,7 +94,57 @@ static struct kretprobe *syscall_regfunc_rp = NULL;
 static struct kretprobe *syscall_unregfunc_rp = NULL;
 #endif
 
+#ifdef CONFIG_KSU_NON_ANDROID
+static DEFINE_SPINLOCK(ksu_init_state_lock);
+bool ksu_android_init_active;
+struct task_struct *ksu_android_init_task;
+bool ksu_syscall_hook_manager_ready;
+static bool ksu_exec_tp_registered;
+static bool ksu_exit_tp_registered;
+
+static void ksu_exec_handler(void *data, struct task_struct *p, pid_t old_pid,
+                             struct linux_binprm *bprm)
+{
+    if (task_pid_vnr(p) != 1 || strcmp(bprm->filename, "/system/bin/init"))
+        return;
+    unsigned long flags;
+    spin_lock_irqsave(&ksu_init_state_lock, flags);
+    if (ksu_android_init_task != p) {
+        if (ksu_android_init_task) {
+            WRITE_ONCE(ksu_android_init_active, false);
+            ksu_clear_task_tracepoint_flag(ksu_android_init_task);
+            put_task_struct(ksu_android_init_task);
+        }
+        get_task_struct(p);
+        WRITE_ONCE(ksu_android_init_task, p);
+    }
+    WRITE_ONCE(ksu_android_init_active, true);
+    ksu_set_task_tracepoint_flag(p);
+    spin_unlock_irqrestore(&ksu_init_state_lock, flags);
+    pr_info("hook_manager: Waydroid init activated (pid %d)\n", task_pid_vnr(p));
+}
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 16, 0)
+static void ksu_exit_handler(void *data, struct task_struct *p, bool group_dead)
+#else
+static void ksu_exit_handler(void *data, struct task_struct *p)
+#endif
+{
+    unsigned long flags;
+    spin_lock_irqsave(&ksu_init_state_lock, flags);
+    if (p == READ_ONCE(ksu_android_init_task)) {
+        WRITE_ONCE(ksu_android_init_active, false);
+        ksu_clear_task_tracepoint_flag(p);
+        WRITE_ONCE(ksu_android_init_task, NULL);
+        put_task_struct(p);
+        pr_info("hook_manager: Waydroid init exited; callbacks remain registered\n");
+    }
+    spin_unlock_irqrestore(&ksu_init_state_lock, flags);
+}
+#endif
+
 #ifdef CONFIG_HAVE_SYSCALL_TRACEPOINTS
+static bool ksu_sys_enter_tp_registered;
 // sys_enter handler: redirect hooked syscalls to the dispatcher
 static void ksu_sys_enter_handler(void *data, struct pt_regs *regs, long id)
 {
@@ -123,6 +176,7 @@ static void ksu_sys_enter_handler(void *data, struct pt_regs *regs, long id)
 
 void __init ksu_syscall_hook_manager_init(void)
 {
+    WRITE_ONCE(ksu_syscall_hook_manager_ready, false);
     int ret;
     pr_info("hook_manager: ksu_hook_manager_init called\n");
 
@@ -137,6 +191,17 @@ void __init ksu_syscall_hook_manager_init(void)
     ksu_register_syscall_hook(__NR_newfstatat, ksu_hook_newfstatat);
     ksu_register_syscall_hook(__NR_faccessat, ksu_hook_faccessat);
 
+#ifdef CONFIG_KSU_NON_ANDROID
+    ret = register_trace_sched_process_exec(ksu_exec_handler, NULL);
+    if (ret)
+        goto fail_tracepoints;
+    ksu_exec_tp_registered = true;
+    ret = register_trace_sched_process_exit(ksu_exit_handler, NULL);
+    if (ret)
+        goto fail_tracepoints;
+    ksu_exit_tp_registered = true;
+#endif
+
 #ifdef CONFIG_HAVE_SYSCALL_TRACEPOINTS
     ret = register_trace_sys_enter(ksu_sys_enter_handler, NULL);
 #ifndef CONFIG_KRETPROBES
@@ -144,22 +209,83 @@ void __init ksu_syscall_hook_manager_init(void)
 #endif
     if (ret) {
         pr_err("hook_manager: failed to register sys_enter tracepoint: %d\n", ret);
+#ifdef CONFIG_KSU_NON_ANDROID
+        goto fail_tracepoints;
+#endif
     } else {
+        ksu_sys_enter_tp_registered = true;
         pr_info("hook_manager: sys_enter tracepoint registered\n");
     }
 #endif
 
     ksu_setuid_hook_init();
     ksu_sucompat_init();
+    WRITE_ONCE(ksu_syscall_hook_manager_ready, true);
+    return;
+#ifdef CONFIG_KSU_NON_ANDROID
+fail_tracepoints:
+#ifdef CONFIG_HAVE_SYSCALL_TRACEPOINTS
+    if (ksu_sys_enter_tp_registered) {
+        unregister_trace_sys_enter(ksu_sys_enter_handler, NULL);
+        ksu_sys_enter_tp_registered = false;
+    }
+#endif
+    if (ksu_exit_tp_registered) {
+        unregister_trace_sched_process_exit(ksu_exit_handler, NULL);
+        ksu_exit_tp_registered = false;
+    }
+    if (ksu_exec_tp_registered) {
+        unregister_trace_sched_process_exec(ksu_exec_handler, NULL);
+        ksu_exec_tp_registered = false;
+    }
+    tracepoint_synchronize_unregister();
+#ifdef CONFIG_KRETPROBES
+    destroy_kretprobe(&syscall_regfunc_rp);
+    destroy_kretprobe(&syscall_unregfunc_rp);
+#endif
+    ksu_unregister_syscall_hook(__NR_setresuid);
+    ksu_unregister_syscall_hook(__NR_execve);
+    ksu_unregister_syscall_hook(__NR_newfstatat);
+    ksu_unregister_syscall_hook(__NR_faccessat);
+#ifndef CONFIG_KRETPROBES
+    ksu_unmark_all_process();
+#endif
+    return;
+#endif
 }
 
 void __exit ksu_syscall_hook_manager_exit(void)
 {
+    unsigned long flags;
+    WRITE_ONCE(ksu_syscall_hook_manager_ready, false);
     pr_info("hook_manager: ksu_hook_manager_exit called\n");
-#ifdef CONFIG_HAVE_SYSCALL_TRACEPOINTS
-    unregister_trace_sys_enter(ksu_sys_enter_handler, NULL);
+#ifdef CONFIG_KSU_NON_ANDROID
+    if (ksu_exit_tp_registered) {
+        unregister_trace_sched_process_exit(ksu_exit_handler, NULL);
+        ksu_exit_tp_registered = false;
+    }
+    if (ksu_exec_tp_registered) {
+        unregister_trace_sched_process_exec(ksu_exec_handler, NULL);
+        ksu_exec_tp_registered = false;
+    }
     tracepoint_synchronize_unregister();
-    pr_info("hook_manager: sys_enter tracepoint unregistered\n");
+    spin_lock_irqsave(&ksu_init_state_lock, flags);
+    WRITE_ONCE(ksu_android_init_active, false);
+    if (ksu_android_init_task) {
+        ksu_clear_task_tracepoint_flag(ksu_android_init_task);
+        put_task_struct(ksu_android_init_task);
+        WRITE_ONCE(ksu_android_init_task, NULL);
+    }
+    spin_unlock_irqrestore(&ksu_init_state_lock, flags);
+#endif
+
+#ifdef CONFIG_HAVE_SYSCALL_TRACEPOINTS
+    if (ksu_sys_enter_tp_registered) {
+        unregister_trace_sys_enter(ksu_sys_enter_handler, NULL);
+        ksu_sys_enter_tp_registered = false;
+        tracepoint_synchronize_unregister();
+        pr_info("hook_manager: sys_enter tracepoint unregistered\n");
+    }
 #endif
 
 #ifdef CONFIG_KRETPROBES
