diff --git a/src/Helpers/AppConfig.cs b/src/Helpers/AppConfig.cs
index d3971b7..3bfe19f 100644
--- a/src/Helpers/AppConfig.cs
+++ b/src/Helpers/AppConfig.cs
@@ -650,0 +651,5 @@ public static class AppConfig
+        // NixOS owns boot/module policy declaratively. Its integration exposes
+        // only the ASUS firmware backend and never creates modprobe/udev files.
+        if (GHelper.Linux.Platform.Linux.NixOS.IsNixOS &&
+            string.IsNullOrEmpty(Environment.GetEnvironmentVariable("GHELPER_TEST_ROOT")))
+            return "asus-wmi";
diff --git a/src/Platform/Linux/MemSleep.cs b/src/Platform/Linux/MemSleep.cs
index bbbaec1..79212e9 100644
--- a/src/Platform/Linux/MemSleep.cs
+++ b/src/Platform/Linux/MemSleep.cs
@@ -21 +21,2 @@ public static class MemSleep
-    public const string StatePath = "/etc/ghelper/mem-sleep";
+    public static readonly string StatePath = NixOS.IsNixOS
+        ? "/var/lib/ghelper-nixos/mem-sleep" : "/etc/ghelper/mem-sleep";
@@ -67,2 +68,16 @@ public static class MemSleep
-        SysfsHelper.RunPkexecBash(
-            $"echo {variant} > {SysPath} && mkdir -p /etc/ghelper && echo {variant} > {StatePath}");
+        if (NixOS.IsNixOS)
+        {
+            string? helper = NixOS.ResolveGpuBlockHelper();
+            if (helper == null)
+            {
+                Helpers.Logger.WriteLine("MemSleep: NixOS state helper is unavailable");
+                return false;
+            }
+            SysfsHelper.RunSudoOrPkexec(helper, new[] { "mem-sleep", variant },
+                sudoTimeoutMs: 30000, pkexecTimeoutMs: 60000);
+        }
+        else
+        {
+            SysfsHelper.RunPkexecBash(
+                $"echo {variant} > {SysPath} && mkdir -p /etc/ghelper && echo {variant} > {StatePath}");
+        }
